NODE_ENV=production
PORT=3000

# Public app URL and optional path prefix
# For a dedicated subdomain like https://pets.example.com, set:
# NEXT_PUBLIC_APP_URL=https://pets.example.com
# NEXT_PUBLIC_BASE_PATH=
# For a subpath deployment like https://example.com/codex-pets, set:
# NEXT_PUBLIC_APP_URL=https://example.com/codex-pets
# NEXT_PUBLIC_BASE_PATH=/codex-pets
NEXT_PUBLIC_APP_URL=https://pets.example.com
NEXT_PUBLIC_BASE_PATH=

# Optional Yandex Metrika Measurement Protocol metrics for aggregate MCP tool
# calls. Use a dedicated technical Metrika ClientID, not a user identifier.
YANDEX_METRIKA_MP_TOKEN=
YANDEX_METRIKA_MP_CLIENT_ID=

# Optional IndexNow notifications. Generate an 8-128 character key with only
# letters, numbers, or hyphens. INDEXNOW_ENDPOINT can usually stay empty.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=

# Optional hybrid search over all approved pets. Keep lexical during migration
# and backfill, then use shadow before switching to hybrid.
PET_SEARCH_MODE=lexical
PET_SEARCH_MODEL_REVISION=yandex-text-search-2026-07
PET_SEARCH_EMBEDDING_TIMEOUT_MS=800
YANDEX_AI_STUDIO_FOLDER_ID=
YANDEX_AI_STUDIO_API_KEY_FILE=/run/secrets/yandex-ai-studio.key

# App-owned auth
AUTH_MODE=app-session
SESSION_COOKIE_SECRET=
PASSWORD_PEPPER=
INITIAL_ADMIN_EMAILS=admin@example.com

# YDB connection
# If any YDB endpoint uses a Docker hostname such as `ydb-local`, run the app
# container on the same Docker network (for example `--network ydb-net`).
YDB_PETS_ENDPOINT=grpc://ydb-host:2137
YDB_PETS_DATABASE=/local/your-tenant
YDB_STATIC_CREDENTIALS_USER=appuser
YDB_STATIC_CREDENTIALS_PASSWORD=
YDB_STATIC_CREDENTIALS_PASSWORD_FILE=/run/secrets/app.password
YDB_STATIC_CREDENTIALS_AUTH_ENDPOINT=grpc://ydb-host:2136
