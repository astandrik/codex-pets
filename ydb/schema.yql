CREATE TABLE codex_pets (
  slug Utf8 NOT NULL,
  id Utf8 NOT NULL,
  display_name Utf8 NOT NULL,
  description Utf8 NOT NULL,
  spritesheet_url Utf8 NOT NULL,
  pet_json_url Utf8 NOT NULL,
  zip_url Utf8 NOT NULL,
  spritesheet_ext Utf8 NOT NULL,
  kind Utf8 NOT NULL,
  tags_json Utf8 NOT NULL,
  status Utf8 NOT NULL,
  owner_id Utf8 NOT NULL,
  owner_email Utf8 NOT NULL,
  owner_name Utf8 NOT NULL,
  contact_email Utf8 NOT NULL,
  rejection_reason Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  approved_at Utf8 NOT NULL,
  rejected_at Utf8 NOT NULL,
  PRIMARY KEY (slug)
);

CREATE TABLE codex_pet_assets (
  asset_id Utf8 NOT NULL,
  pet_json_bytes String NOT NULL,
  spritesheet_bytes String NOT NULL,
  zip_bytes String NOT NULL,
  spritesheet_ext Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (asset_id)
);

CREATE TABLE codex_pet_search_embeddings (
  model_revision Utf8 NOT NULL,
  pet_slug Utf8 NOT NULL,
  source_hash Utf8 NOT NULL,
  dimensions Uint32 NOT NULL,
  embedding String NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (model_revision, pet_slug)
);

CREATE TABLE codex_pet_search_captions (
  caption_revision Utf8 NOT NULL,
  pet_slug Utf8 NOT NULL,
  source_hash Utf8 NOT NULL,
  caption_json Utf8 NOT NULL,
  caption_text Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (caption_revision, pet_slug)
);

CREATE TABLE codex_pet_related_state (
  state_id Utf8 NOT NULL,
  requested_generation_id Utf8,
  active_generation_id Utf8,
  previous_generation_id Utf8,
  status Utf8 NOT NULL,
  ranking_revision Utf8 NOT NULL,
  failure_reason Utf8,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (state_id)
);

CREATE TABLE codex_pet_related_snapshots (
  generation_id Utf8 NOT NULL,
  source_slug Utf8 NOT NULL,
  ranking_revision Utf8 NOT NULL,
  related_slugs_json Json NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (generation_id, source_slug)
);

CREATE TABLE codex_pet_related_annotations (
  annotation_revision Utf8 NOT NULL,
  pet_slug Utf8 NOT NULL,
  source_hash Utf8 NOT NULL,
  proposal_json Utf8 NOT NULL,
  annotation_json Utf8 NOT NULL,
  annotation_text Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (annotation_revision, pet_slug)
);

-- Historical additive table already present in production. Current V24 does
-- not read or write pair scores, but the canonical schema retains the table.
CREATE TABLE codex_pet_related_pair_scores (
  scoring_revision Utf8 NOT NULL,
  left_slug Utf8 NOT NULL,
  right_slug Utf8 NOT NULL,
  source_hash Utf8 NOT NULL,
  relevance_grade Uint32 NOT NULL,
  confidence Utf8 NOT NULL,
  relation_types_json Json NOT NULL,
  reason_codes_json Json NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (scoring_revision, left_slug, right_slug)
);

CREATE TABLE codex_pet_approval_preparations (
  preparation_id Utf8 NOT NULL,
  pet_id Utf8 NOT NULL,
  pet_slug Utf8 NOT NULL,
  pet_updated_at Utf8 NOT NULL,
  reviewer_id Utf8 NOT NULL,
  ranking_revision Utf8 NOT NULL,
  expected_active_generation_id Utf8 NOT NULL,
  prepared_generation_id Utf8 NOT NULL,
  status Utf8 NOT NULL,
  attempts Uint32 NOT NULL,
  next_attempt_at Utf8 NOT NULL,
  lease_owner Utf8 NOT NULL,
  lease_until Utf8 NOT NULL,
  failure_code Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (preparation_id)
);

CREATE TABLE codex_users (
  user_id Utf8 NOT NULL,
  email Utf8 NOT NULL,
  email_lower Utf8 NOT NULL,
  password_hash Utf8 NOT NULL,
  display_name Utf8 NOT NULL,
  profile_slug Utf8 NOT NULL,
  bio Utf8 NOT NULL,
  website_url Utf8 NOT NULL,
  github_url Utf8 NOT NULL,
  linkedin_url Utf8 NOT NULL,
  avatar_id Utf8 NOT NULL,
  role Utf8 NOT NULL,
  status Utf8 NOT NULL,
  email_verified_at Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (user_id)
);

CREATE TABLE codex_user_avatars (
  avatar_id Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  content_type Utf8 NOT NULL,
  size_bytes Uint32 NOT NULL,
  image_bytes String NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (avatar_id)
);

CREATE TABLE codex_user_profile_slugs (
  profile_slug Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (profile_slug)
);

CREATE TABLE codex_sessions (
  session_id Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  expires_at Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (session_id)
);

CREATE TABLE codex_email_verification_tokens (
  token_hash Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  email_lower Utf8 NOT NULL,
  expires_at Utf8 NOT NULL,
  consumed_at Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (token_hash)
);

CREATE TABLE codex_password_reset_tokens (
  token_hash Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  email_lower Utf8 NOT NULL,
  expires_at Utf8 NOT NULL,
  consumed_at Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (token_hash)
);

CREATE TABLE codex_pet_upload_sessions (
  id Utf8 NOT NULL,
  owner_id Utf8 NOT NULL,
  pet_id_hint Utf8 NOT NULL,
  slug_hint Utf8 NOT NULL,
  zip_url Utf8 NOT NULL,
  pet_json_url Utf8 NOT NULL,
  spritesheet_url Utf8 NOT NULL,
  spritesheet_ext Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  expires_at Utf8 NOT NULL,
  consumed_at Utf8 NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE codex_pet_reviews (
  id Utf8 NOT NULL,
  pet_id Utf8 NOT NULL,
  reviewer_id Utf8 NOT NULL,
  decision Utf8 NOT NULL,
  reason Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE codex_pet_metrics (
  pet_slug Utf8 NOT NULL,
  download_count Uint32 NOT NULL,
  install_count Uint32 NOT NULL,
  like_count Uint32 NOT NULL,
  updated_at Utf8 NOT NULL,
  PRIMARY KEY (pet_slug)
);

CREATE TABLE codex_pet_generation_requests (
  id Utf8 NOT NULL,
  status Utf8 NOT NULL,
  kind Utf8 NOT NULL,
  display_name_hint Utf8 NOT NULL,
  prompt Utf8 NOT NULL,
  contact_email Utf8 NOT NULL,
  requester_name Utf8 NOT NULL,
  requester_user_id Utf8 NOT NULL,
  linked_pet_id Utf8 NOT NULL,
  linked_pet_slug Utf8 NOT NULL,
  admin_note Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  fulfilled_at Utf8 NOT NULL,
  rejected_at Utf8 NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE codex_pet_generation_request_images (
  request_id Utf8 NOT NULL,
  file_name Utf8 NOT NULL,
  content_type Utf8 NOT NULL,
  size_bytes Uint32 NOT NULL,
  image_bytes String NOT NULL,
  created_at Utf8 NOT NULL,
  PRIMARY KEY (request_id)
);

CREATE TABLE codex_pet_generation_runs (
  id Utf8 NOT NULL,
  request_id Utf8 NOT NULL,
  idempotency_key Utf8 NOT NULL,
  status Utf8 NOT NULL,
  base_revision Uint32 NOT NULL,
  targeted_retry_count Uint32 NOT NULL,
  image_call_count Uint32 NOT NULL,
  last_stage Utf8 NOT NULL,
  failure_code Utf8 NOT NULL,
  failure_message Utf8 NOT NULL,
  review_json Utf8 NOT NULL,
  final_id Utf8 NOT NULL,
  final_display_name Utf8 NOT NULL,
  final_description Utf8 NOT NULL,
  final_kind Utf8 NOT NULL,
  final_tags_json Utf8 NOT NULL,
  final_pet_id Utf8 NOT NULL,
  final_pet_slug Utf8 NOT NULL,
  approved_by Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  completed_at Utf8 NOT NULL,
  cancelled_at Utf8 NOT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE codex_pet_generation_stage_attempts (
  run_id Utf8 NOT NULL,
  stage Utf8 NOT NULL,
  attempt Uint32 NOT NULL,
  status Utf8 NOT NULL,
  lease_owner Utf8 NOT NULL,
  lease_token Utf8 NOT NULL,
  lease_expires_at Utf8 NOT NULL,
  heartbeat_at Utf8 NOT NULL,
  request_hash Utf8 NOT NULL,
  model Utf8 NOT NULL,
  usage_json Utf8 NOT NULL,
  provider_request_id Utf8 NOT NULL,
  error_code Utf8 NOT NULL,
  error_message Utf8 NOT NULL,
  ambiguous Bool NOT NULL,
  started_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  completed_at Utf8 NOT NULL,
  PRIMARY KEY (run_id, stage, attempt)
);

CREATE TABLE codex_pet_generation_artifacts (
  run_id Utf8 NOT NULL,
  artifact_key Utf8 NOT NULL,
  stage Utf8 NOT NULL,
  file_name Utf8 NOT NULL,
  content_type Utf8 NOT NULL,
  byte_size Uint64 NOT NULL,
  sha256 Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  expires_at Utf8 NOT NULL,
  retained Bool NOT NULL,
  PRIMARY KEY (run_id, artifact_key)
);

CREATE TABLE codex_pet_generation_artifact_chunks (
  run_id Utf8 NOT NULL,
  artifact_key Utf8 NOT NULL,
  chunk_number Uint32 NOT NULL,
  size_bytes Uint32 NOT NULL,
  chunk_bytes String NOT NULL,
  PRIMARY KEY (run_id, artifact_key, chunk_number)
);

CREATE TABLE codex_idempotency_keys (
  route Utf8 NOT NULL,
  idempotency_key Utf8 NOT NULL,
  request_hash Utf8 NOT NULL,
  status Utf8 NOT NULL,
  status_code Uint32 NOT NULL,
  response_json Utf8 NOT NULL,
  created_at Utf8 NOT NULL,
  updated_at Utf8 NOT NULL,
  claim_token Utf8 NOT NULL,
  expires_at Utf8 NOT NULL,
  PRIMARY KEY (route, idempotency_key)
);

CREATE TABLE codex_schema_migrations (
  id Utf8 NOT NULL,
  applied_at Utf8 NOT NULL,
  PRIMARY KEY (id)
);
